# Copy to .env for local development (`npm run dev`). On Vercel, set these as
# project environment variables instead.

# Required: Gemini API key - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: pin one or more Gemini model IDs (comma-separated, tried in order).
# Defaults to gemini-flash-latest, then gemini-3.5-flash, then gemini-2.5-flash.
GEMINI_MODEL=

# Optional but recommended for anything reachable from the internet: every /api
# request must send this value (enter it once in the app's Settings).
APP_ACCESS_KEY=

# Optional: extra browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=
